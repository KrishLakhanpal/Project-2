# Copy this file to ".env" and fill in your key.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Check https://ai.google.dev/gemini-api/docs/models for the latest model
# name and change this if the default below is deprecated by the time you
# read this.
GEMINI_MODEL=gemini-2.5-flash

# Path to the tesseract binary. Usually not needed on Linux/Mac if installed
# via package manager. On Windows, set the full path, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# How often (seconds) the live monitor re-checks the selected screen region
LIVE_MONITOR_INTERVAL=2.5

# Seconds a sandboxed test-run of generated code is allowed before it is killed
SANDBOX_TIMEOUT=5
